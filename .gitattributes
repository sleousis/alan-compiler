# Shell scripts must keep LF endings or bash fails with "bad interpreter"
alan text eol=lf
*.sh text eol=lf
alan_lib_v2/change_syms text eol=lf
Makefile text eol=lf
# Test inputs and expected output are byte-exact program data
tests/inputs/*.txt -text
tests/expected/*.txt -text
runtime/test/rt_test_input.txt -text
runtime/test/rt_test_expected.txt -text
