-- A function uses the variable its declaration sees, even when the
-- caller has a parameter or local of the same name (C9).
main () : proc
  x : int;
  e () : proc
  {
    writeInteger(x);
    writeString("\n");
  }
  f (x : int) : proc
  {
    e();
  }
  g () : proc
    x : int;
  {
    x = 3;
    e();
  }
{
  x = 1;
  f(2);
  g();
}
